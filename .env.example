# Copiar como .env y completar. El .env no se sube al repo.

# Cualquier proveedor compatible con la API de OpenAI.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# Alternativa:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=

# Postgres con pgvector, para la resolucion de catalogo.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orders
