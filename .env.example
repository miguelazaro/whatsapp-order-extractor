# Copia este archivo como .env y pon tus valores.
# El .env NUNCA se sube al repo.

# Cualquier proveedor compatible con la API de OpenAI.
# Gemini es gratis y no pide tarjeta: https://aistudio.google.com
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=pon-tu-llave-aqui
LLM_MODEL=toma-el-nombre-del-modelo-flash-de-ai-studio

# Alternativa si te topas con los limites de Gemini:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=el-modelo-que-elijas-en-groq

# Postgres con pgvector. Solo hace falta en la fase del catalogo.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orders
